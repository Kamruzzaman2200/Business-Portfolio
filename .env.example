# PostgreSQL connection URL (Neon, Supabase, Railway, or local Docker)
DATABASE_URL="postgresql://username:password@hostname:5432/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://username:password@hostname:5432/dbname?sslmode=require"

# Admin dashboard login credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password

# 32+ character random secret used for session cookie encryption (min 32 chars)
NUXT_SESSION_PASSWORD=replace_with_a_32_character_long_random_string_here
